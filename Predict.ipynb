    "def extract_relationships(predicted_entities):\n",
    "    \"\"\"\n",
    "    Extracts structured financial relationships for multiple properties using nested lists.\n",
    "    Returns: List of (property, years, values)\n",
    "    \"\"\"\n",
    "    relationships = []\n",
