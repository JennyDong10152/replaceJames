    "import re\n",
    "\n",
    "def extract_values(predicted_entities):\n",
    "    \"\"\"\n",
    "    Matches multiple BERT-CRF label sequences for values + multipliers + units,\n",
    "    while appending indices to know the position of each token and its label.\n",
    "    \n",
    "    Input: [(\"200\", \"B-VALUE\"), (\"billion\", \"B-MULTIPLIER\"), (\"dollars\", \"B-UNIT\"), \n",
    "            (\"O\", \"O\"), (\"150\", \"B-VALUE\"), (\"million\", \"B-MULTIPLIER\"), \n",
    "            (\"O\", \"O\"), (\"75\", \"B-VALUE\")]\n",
    "    Output: [\"200 billion dollars\", \"150 million\", \"75\"]\n",
    "    \"\"\"\n",
    "    labels = \" \".join(label for _, label in predicted_entities)\n",
    "    tokens = [token for token, _ in predicted_entities]\n",
    "\n",
    "    indexed_tokens = [(token, label, idx) for idx, (token, label) in enumerate(predicted_entities)]\n",
    "\n",
    "    segments = re.split(r\"\\s*O\\s*\", labels)\n",
    "\n",
    "    matches = []\n",
    "    token_idx = 0\n",
    "    units = []\n",
    "\n",
    "    for segment in segments:\n",
    "        segment = segment.strip()\n",
    "        current_unit = \"\"\n",
    "        value = \"\"\n",
    "        multiplier = \"\"\n",
    "\n",
    "        if segment and \"B-VALUE\" in segment:\n",
    "            segment_tokens = segment.split()\n",
    "\n",
    "            for idx in range(token_idx, len(predicted_entities)):\n",
    "                token, label = predicted_entities[idx]\n",
    "                if label in [\"B-VALUE\"]:\n",
    "                    segment_start_idx = idx\n",
    "                    break\n",
    "                    \n",
    "            segment_end_idx = segment_start_idx + len(segment_tokens)\n",
    "\n",
    "            for idx in range(segment_start_idx, segment_end_idx):\n",
    "                token, label = predicted_entities[idx]\n",
    "                if label.startswith(\"B-VALUE\"):\n",
    "                    value = token\n",
    "                elif label.startswith(\"I-VALUE\"):\n",
    "                    value +=  token.replace(\"##\", \"\")\n",
    "                elif label.startswith(\"B-UNIT\"):\n",
    "                    current_unit = token\n",
    "                    units.append(token)\n",
    "                elif label.startswith(\"I-UNIT\"):\n",
    "                    current_unit += token\n",
    "                    units[-1] = current_unit\n",
    "                elif label.startswith(\"B-MULTIPLIER\"):\n",
    "                    multiplier = token\n",
    "                elif label.startswith(\"I-MULTIPLIER\"):\n",
    "                    multiplier += token.replace(\"##\", \"\")\n",
    "                else:\n",
    "                    break\n",
    "            if not current_unit:\n",
    "                units.append(None)\n",
    "                \n",
    "            value_str = value + (\" \" + multiplier if multiplier else \"\") + (\" \" + current_unit if current_unit else \"\")\n",
    "            matches.append(value_str.strip())\n",
    "            token_idx = segment_end_idx\n",
    "            \n",
    "    if matches and units[-1] and not any(units[:-1]):\n",
    "        unit = units[-1]\n",
    "        for idx in range(0, len(matches)-1):\n",
    "            matches[idx] += \" \" + unit\n",
    "    return matches if matches else None \n",
    "\n",
    "# labeled_entities = [\n",
    "#     (\"200\", \"B-VALUE\"), (\"billion\", \"B-MULTIPLIER\"), (\"dollars\", \"B-UNIT\"),\n",
    "#     (\"O\", \"O\"),(\"O\",\"O\"),  # Separator\n",
    "#     (\"150\", \"B-VALUE\"), (\"million\", \"B-MULTIPLIER\"),\n",
    "#     (\"O\", \"O\"),  # Separator\n",
    "#     (\"75\", \"B-VALUE\")\n",
    "# ]\n",
    "\n",
    "labeled_entities = [\n",
    "    (\"200\", \"B-VALUE\"), (\"billion\", \"B-MULTIPLIER\"),\n",
    "    (\"O\", \"O\"),(\"O\",\"O\"),  # Separator\n",
    "    (\"150\", \"B-VALUE\"), (\"million\", \"B-MULTIPLIER\"),\n",
    "    (\"O\", \"O\"),  # Separator\n",
    "    (\"75\", \"B-VALUE\"), (\"dollars\", \"B-UNIT\"),\n",
    "]\n",
    "\n",
    "result = extract_values(labeled_entities)\n",
    "print(result)  "
   ]
