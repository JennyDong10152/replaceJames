    "def segment_by_property(predicted_entities):\n",
    "    \"\"\"\n",
    "    Splits sentence into segments, each starting with a new B-PROPERTY.\n",
    "    Each segment collects its own values and years.\n",
    "    \n",
    "    Returns: List of (property_name, segment_entities)\n",
    "    \"\"\"\n",
    "    segments = []\n",
    "    current_segment = []\n",
    "    properties = []\n",
    "    current_property = None\n",
    "    \n",
    "    for token, label in predicted_entities:\n",
    "        if label.startswith(\"B-PROPERTY\"):\n",
    "            if current_property and current_segment:\n",
    "                properties.append(current_property)\n",
    "                segments.append(current_segment)\n",
    "            current_property = token \n",
    "            current_segment = [(token, label)]\n",
    "        elif label.startswith(\"I-PROPERTY\"):\n",
    "            current_property += \" \" + token.replace(\"##\", \"\")\n",
    "        else:\n",
    "            current_segment.append((token, label))\n",
    "\n",
    "    if not current_property:\n",
    "        return [], None\n",
    "        \n",
    "    properties.append(current_property)\n",
    "    segments.append(current_segment)\n",
    "    return properties, segments"
   ]
  },
