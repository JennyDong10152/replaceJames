    "def load_model(save_directory=\"bert_crf_model\", device=\"cpu\"):\n",
    "    \"\"\"Loads the trained BertCRF model, tokenizer, and label map.\"\"\"\n",
    "    \n",
    "    model_path = f\"{save_directory}/bert_crf_model.pt\"\n",
    "    label_map_path = f\"{save_directory}/label_map.json\"\n",
    "\n",
    "    # 🔹 Load label map\n",
    "    with open(label_map_path, \"r\") as f:\n",
    "        label_map = json.load(f)\n",
    "    print(f\"Label map loaded from {label_map_path}\")\n",
    "\n",
    "    # 🔹 Load tokenizer\n",
    "    tokenizer = BertTokenizerFast.from_pretrained(save_directory)\n",
    "    print(f\"Tokenizer loaded from {save_directory}\")\n",
    "\n",
    "    # 🔹 Initialize BertCRF properly before loading weights\n",
    "    model = BertCRF(num_labels=len(label_map)).to(device)\n",
    "    model.load_state_dict(torch.load(model_path, map_location=torch.device(device)))\n",
    "    model.eval()  # Set model to evaluation mode\n",
    "\n",
    "    print(f\"Model successfully loaded from {model_path}\")\n",
    "    return model, tokenizer, label_map"
   ]
  },
