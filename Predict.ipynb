    "def process_sentence(document):\n",
    "    \"\"\"\n",
    "    Processes financial text to extract structured relationships.\n",
    "    \n",
    "    Steps:\n",
    "    1️⃣ Runs BERT-CRF for entity labeling.\n",
    "    2️⃣ Extracts structured relationships.\n",
    "    3️⃣ Stores results in a structured dictionary.\n",
    "    \n",
    "    Returns: \n",
    "        Dictionary structured as {Company: {Property: {Year: Value}}}\n",
    "    \"\"\"\n",
    "    doc = nlp(document)  # Use spaCy to split sentences\n",
    "    company_data = {}\n",
    "\n",
    "    last_company = None  # Track last seen company\n",
    "\n",
    "    for sent in doc.sents:\n",
    "        sentence = sent.text.strip()\n",
    "        predicted_entities = predict(sentence) \n",
    "        company, property, years, values = extract_relationships(predicted_entities)\n",
    "        if company:\n",
    "            last_company = company\n",
    "\n",
    "        if last_company not in company_data:\n",
    "            company_data[last_company] = {}\n",
    "        if property not in company_data[last_company]:\n",
