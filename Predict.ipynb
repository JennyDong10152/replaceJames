    "def extract_years(segment_entities):\n",
    "    \"\"\"\n",
    "    Extracts all years within a segment as a list of lists.\n",
    "    \"\"\"\n",
    "    years = []\n",
    "    current_year = \"\"\n",
    "    timestamp = \"\"\n",
    "\n",
    "    for token, label in segment_entities:\n",
    "        if label.startswith(\"B-TIMESTAMP\"):\n",
    "            timestamp = token\n",
    "        elif label.startswith(\"I-TIMESTAMP\"):\n",
    "            timestamp += \" \" + token.replace(\"##\", \"\")\n",
    "        elif label.startswith(\"B-YEAR\"):\n",
    "            if current_year:\n",
    "                years.append(((timestamp + \" \") if timestamp else \"\") + current_year)\n",
    "            current_year = token\n",
    "\n",
    "        elif label.startswith(\"I-YEAR\"):\n",
    "            current_year += token.replace(\"##\", \"\")\n",
    "\n",
    "    if current_year:\n",
    "        years.append(((timestamp + \" \") if timestamp else \"\") + current_year)\n",
    "\n",
    "    return years\n",
    "\n",
    "test_entities = [('revenue', 'B-PROPERTY'), ('from', 'O'), ('RMB', 'B-UNIT'), ('831', 'B-VALUE'), ('.', 'I-VALUE'), ('6', 'I-VALUE'), ('million', 'B-MULTIPLIER'), ('in', 'O'), ('dd', \"B-TIMESTAMP\"), ('2021', 'B-YEAR'), ('to', 'O'), ('RMB', 'B-UNIT'), ('1,044', 'B-VALUE'), ('.', 'I-VALUE'), ('3', 'I-VALUE'), ('million', 'B-MULTIPLIER'), ('in', 'O'), ('2022', 'B-YEAR'), ('and', 'O'), ('to', 'O'), ('RMB', 'B-UNIT'), ('1,518', 'B-VALUE'), ('.', 'I-VALUE'), ('6', 'I-VALUE'), ('million', 'B-MULTIPLIER'), ('in', 'O'), ('2023', 'B-YEAR'), (',', 'O'), ('as', 'O'), ('a', 'O'), ('result', 'O'), ('of', 'O'), ('an', 'O'), ('increase', 'O'), ('in', 'O'), ('the', 'O')]\n",
    "extract_years(test_entities)"
   ]
