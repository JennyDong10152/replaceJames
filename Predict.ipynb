    "    years = extract_years(predicted_entities)\n",
    "    values = extract_values(predicted_entities)\n",
    "    company = extract_company(predicted_entities)\n",
    "    property = extract_property(predicted_entities)\n",
    "    \n",
    "    return company, property, years, values"
